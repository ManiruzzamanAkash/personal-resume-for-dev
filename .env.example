# ============================================================
#  .env.example — copy to .env.local and fill in.
#
#  Next.js inlines NEXT_PUBLIC_* variables into the client bundle
#  at BUILD time, so for production deploys these must be present
#  when `npm run build` runs (locally, or in your CI/CD pipeline).
#
#  For GitHub Pages: add NEXT_PUBLIC_WEB3FORMS_KEY as a repository
#  secret, then expose it to the build step in
#  `.github/workflows/deploy.yml` via:
#
#    env:
#      NEXT_PUBLIC_WEB3FORMS_KEY: ${{ secrets.NEXT_PUBLIC_WEB3FORMS_KEY }}
# ============================================================

# Web3Forms — contact form delivery (https://web3forms.com)
# Sign up with the email you want to receive submissions at, copy
# the access key from the dashboard, paste below. Free tier:
# 250 submissions/month, no credit card.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 — site analytics (https://analytics.google.com)
# Create a GA4 property, grab the Measurement ID (looks like
# G-XXXXXXXXXX) from Admin → Data Streams → Web. Leave blank to
# disable — no GA scripts are injected when this is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — domain verification (https://search.google.com/search-console)
# Add your property, choose the "HTML tag" verification method, copy
# only the value of the `content` attribute (not the whole tag) and
# paste below. Leave blank to skip verification meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
